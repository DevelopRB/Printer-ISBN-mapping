# Printer credentials — NEVER commit real passwords.
# Copy to .env and fill in values. .env is gitignored.

PRINTER_1_USERNAME=admin
PRINTER_1_PASSWORD=

PRINTER_2_USERNAME=admin
PRINTER_2_PASSWORD=

PRINTER_3_USERNAME=admin
PRINTER_3_PASSWORD=

# Apply ONLY to HTTPS printer connections (self-signed certs on internal network).
# Security: disabling verification allows MitM on the path to the printer.
# Use only on a trusted internal LAN with known printer IPs. Default: false.
PRINTER_VERIFY_SSL=false

PRINTER_CONNECT_TIMEOUT=8
PRINTER_READ_TIMEOUT=15

# Phase 2C development probe. Set false/omit in production.
PRINTER_JOBLOG_DEBUG=true
