# Template only. Installers no longer bundle any env file with values; they ship the
# root .env.example as env.example and IT fills passwords into
# %APPDATA%\Printing Reconciliation\.env on each machine.
# This file is backend-only. Never expose passwords to the Electron renderer.

PRINTER_1_USERNAME=admin
PRINTER_1_PASSWORD=

PRINTER_2_USERNAME=admin
PRINTER_2_PASSWORD=

PRINTER_3_USERNAME=admin
PRINTER_3_PASSWORD=

PRINTER_VERIFY_SSL=false
PRINTER_CONNECT_TIMEOUT=8
PRINTER_READ_TIMEOUT=15
PRINTER_JOBLOG_DEBUG=false
